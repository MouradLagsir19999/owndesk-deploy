      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Shared mailbox address for tickets by mail (used from OD-008)."
      }
    },
    "budgetEuro": {
      "type": "int",
      "defaultValue": 50,
      "minValue": 1,
      "metadata": {
        "description": "Monthly budget in euro for this resource group. Alerts only: a budget does not stop spending."
      }
