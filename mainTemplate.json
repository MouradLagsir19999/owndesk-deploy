      "type": "securestring",
      "defaultValue": "[format('Od1!{0}', newGuid())]",
      "metadata": {
        "description": "Generated database password. Never shown; stored only in Key Vault."
      }
    },
    "setupCode": {
      "type": "securestring",
      "defaultValue": "[newGuid()]",
      "metadata": {
        "description": "Generated one-time code for the setup wizard. Never shown; read it from Key Vault."
      }
    }
  },
